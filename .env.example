# Copy with `npm run setup`. Local defaults; use your deployed origin on Vercel.
APP_URL=http://localhost:3000

# Supabase Project Settings > API (or `npx supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: new secret key, or legacy service_role key for local Supabase.
SUPABASE_SECRET_KEY=

# Stripe TEST mode / sandbox. Never put these in NEXT_PUBLIC_* variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A recurring price from the same Stripe account and mode as your secret key.
# Monthly/quantity-one plan metadata: included_checkpoints, overage_policy=blocked,
# and plan_version. See docs/MCP_BILLING_HANDOFF.md; metadata is not a usage ledger.
STRIPE_PRICE_ID=

# OpenAI API project key; a ChatGPT subscription does not include API usage.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_REQUIRE_SUBSCRIPTION=false

# Glass Box — Reveal/Critique/guidance calls. Provider: openai (default, uses OPENAI_API_KEY)
# or anthropic (uses ANTHROPIC_API_KEY). Leave the model names blank for provider defaults.
GLASSBOX_PROVIDER=openai
GLASSBOX_MODEL=
# Retried once if GLASSBOX_MODEL refuses or returns unparseable output.
GLASSBOX_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
