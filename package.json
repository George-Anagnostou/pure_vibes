{
  "name": "pure-vibes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "env:check": "node --env-file-if-exists=.env.local scripts/check-env.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:push": "supabase db push",
    "db:types": "node scripts/db-types.mjs",
    "db:test": "supabase test db",
    "stripe": "node --env-file-if-exists=.env.local scripts/stripe.mjs",
    "stripe:listen": "npm run stripe -- listen --forward-to localhost:3000/api/stripe/webhook"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^7.0.127",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
